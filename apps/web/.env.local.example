# =============================================================================
# Clerk
# =============================================================================
# https://dashboard.clerk.com → API Keys

# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...

# Webhook signing secret (https://dashboard.clerk.com → Webhooks → Endpoint)
# Aponta o endpoint do Clerk pra https://<seu-domínio>/api/webhooks/clerk
# CLERK_WEBHOOK_SECRET=whsec_...

# Domain Clerk usado pelo Supabase pra validar JWT via JWKS
# (ex: your-app.clerk.accounts.dev — sem https://)
# CLERK_DOMAIN=your-app.clerk.accounts.dev

# URLs (defaults já cobrem; descomentar só se quiser sobrescrever)
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
# NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# =============================================================================
# Supabase
# =============================================================================
# Local dev: pegar do `pnpm db:start` (imprime URL, anon, service_role)
# Prod: dashboard.supabase.com → Project Settings → API

# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   # SERVER-ONLY — NUNCA expor via NEXT_PUBLIC_

# =============================================================================
# LLM (Anthropic + Langfuse)
# =============================================================================
# A 0.3a usa essas vars somente no agent-runtime. Estão listadas aqui apenas
# pra centralizar referência; o `apps/web` nunca importa o wrapper de LLM
# direto (regra: chamada de LLM passa SEMPRE pelo serviço de agentes).

# ANTHROPIC_API_KEY=sk-ant-...
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com   # ou https://us.cloud.langfuse.com

# Budgets default (override por chamada)
# LLM_DEFAULT_BUDGET_MAX_TOKENS=4000
# LLM_DEFAULT_BUDGET_MAX_COST_USD=0.1

# Overrides opcionais por tier
# LLM_MODEL_TRIAGE=claude-haiku-4-5-20251001
# LLM_MODEL_DEFAULT=claude-sonnet-4-6
# LLM_MODEL_CRITICAL=claude-opus-4-7

# =============================================================================
# Realtime (Sprint 0.3b)
# =============================================================================
# Cliente Socket.io conecta direto no agent-runtime. Em dev é o serviço local;
# em prod, ws público (atrás do mesmo domínio ou subdomínio dedicado).
NEXT_PUBLIC_AGENT_RUNTIME_URL=http://localhost:3001

# Compartilhado com o agent-runtime — usado pra assinar payloads internos
# (HMAC, ver ADR-003). Não NEXT_PUBLIC_, server-only.
# INTERNAL_SERVICE_TOKEN=...
