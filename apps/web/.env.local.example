# =============================================================================
# Clerk
# =============================================================================
# https://dashboard.clerk.com → API Keys

# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...

# Webhook signing secret (https://dashboard.clerk.com → Webhooks → Endpoint)
# Aponta o endpoint do Clerk pra https://<seu-domínio>/api/webhooks/clerk
# CLERK_WEBHOOK_SECRET=whsec_...

# Domain Clerk usado pelo Supabase pra validar JWT via JWKS
# (ex: your-app.clerk.accounts.dev — sem https://)
# CLERK_DOMAIN=your-app.clerk.accounts.dev

# URLs (defaults já cobrem; descomentar só se quiser sobrescrever)
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
# NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# =============================================================================
# Supabase
# =============================================================================
# Local dev: pegar do `pnpm db:start` (imprime URL, anon, service_role)
# Prod: dashboard.supabase.com → Project Settings → API

# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   # SERVER-ONLY — NUNCA expor via NEXT_PUBLIC_
