# =============================================================================
# agent-runtime — env vars
# =============================================================================
# Copie pra `.env` (gitignored) ou exporte via shell antes de subir o serviço.
# Sprint 0.3a: shared-llm precisa de Anthropic + Langfuse + budgets.

# ---------------------------------------------------------------------------
# Anthropic
# ---------------------------------------------------------------------------
# https://console.anthropic.com → Settings → API Keys
# ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Langfuse v5 (OTEL-based tracing)
# ---------------------------------------------------------------------------
# https://cloud.langfuse.com → Settings → API Keys
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com   # ou https://us.cloud.langfuse.com

# ---------------------------------------------------------------------------
# Budgets default (override por chamada via llmCall({ budget }))
# ---------------------------------------------------------------------------
# LLM_DEFAULT_BUDGET_MAX_TOKENS=4000
# LLM_DEFAULT_BUDGET_MAX_COST_USD=0.1

# ---------------------------------------------------------------------------
# Overrides opcionais de modelo por tier
# ---------------------------------------------------------------------------
# LLM_MODEL_TRIAGE=claude-haiku-4-5-20251001
# LLM_MODEL_DEFAULT=claude-sonnet-4-6
# LLM_MODEL_CRITICAL=claude-opus-4-7

# ---------------------------------------------------------------------------
# Sprint 0.3b: bus de eventos + Socket.io
# ---------------------------------------------------------------------------
# Redis (BullMQ + pub/sub). Dev: docker compose up -d redis.
# REDIS_URL=redis://localhost:6379

# Concurrency do worker BullMQ (default 5).
# BULLMQ_CONCURRENCY=5

# Origem permitida pelo CORS do Socket.io (apps/web em dev).
# WEB_ORIGIN=http://localhost:3000

# HMAC entre apps/web e agent-runtime (ADR-003). Gerar com:
#   openssl rand -hex 32
# INTERNAL_SERVICE_TOKEN=...

# Clerk Backend SDK pra validar JWT no handshake Socket.io via JWKS.
# CLERK_DOMAIN=your-app.clerk.accounts.dev
# CLERK_SECRET_KEY=sk_test_...

# Supabase (service role) pra resolver clerk_org_id → tenant interno no handshake.
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
