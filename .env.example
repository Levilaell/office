# =============================================================================
# OFFICE — Environment Variables
# =============================================================================
# Copie este arquivo pra .env.local nos 3 apps que rodam:
#   - apps/web/.env.local
#   - apps/agent-runtime/.env.local
#   - apps/workers/.env.local
#
# Mantenha os 3 arquivos SINCRONIZADOS (mesmo conteúdo, mesmas chaves).
# Tech debt: consolidar em fonte única + dotenvx --env-file relativo (issue #TBD).
#
# Todos os arquivos .env.local estão no .gitignore — NUNCA commitar.
# =============================================================================


# -----------------------------------------------------------------------------
# LLM — Anthropic (modelo principal)
# https://console.anthropic.com/settings/keys
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-...


# -----------------------------------------------------------------------------
# Observabilidade LLM — Langfuse
# https://cloud.langfuse.com → Project Settings → API Keys
# -----------------------------------------------------------------------------
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...


# -----------------------------------------------------------------------------
# Supabase Cloud (ADR-012)
# Dashboard → Project Settings → API
# Dois nomes pra mesma URL/key: o NEXT_PUBLIC_* é exposto no client (Next),
# o sem prefixo é só server (agent-runtime, workers, API routes).
# Mantemos os dois pra evitar quebra de imports legados.
# -----------------------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=eyJhbG...
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbG...
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...   # ⚠️ SECRET — não expor no client


# -----------------------------------------------------------------------------
# Clerk — Auth
# https://dashboard.clerk.com → API Keys
# -----------------------------------------------------------------------------
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Domínio do Clerk frontend (sem https://). Usado pelo Supabase TPA pra
# resolver o JWKS endpoint. Encontrado em Dashboard → API Keys → "Frontend API"
CLERK_DOMAIN=<your-app>.clerk.accounts.dev


# -----------------------------------------------------------------------------
# Redis (ADR-013)
# Local: redis-server nativo no WSL/Linux. Produção: Upstash/Railway.
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379


# -----------------------------------------------------------------------------
# Comunicação inter-serviços (ADR-003)
# Token compartilhado entre apps/web e apps/agent-runtime pra HMAC.
# Gere com:  openssl rand -hex 32
# Todos os 3 apps devem ter o MESMO valor.
# -----------------------------------------------------------------------------
INTERNAL_SERVICE_TOKEN=<gere com `openssl rand -hex 32`>


# -----------------------------------------------------------------------------
# URLs públicas
# -----------------------------------------------------------------------------
# URL do agent-runtime pra browser conectar via Socket.io.
# Local: http://localhost:3001. Produção: subdomínio dedicado (ws.office.app).
NEXT_PUBLIC_AGENT_RUNTIME_URL=http://localhost:3001